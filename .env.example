# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/automated_software
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/automated_software

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# MailSlurp - Email OTP
MAILSLURP_API_KEY=your_mailslurp_api_key_here

# 5SIM - Mobile OTP (Primary)
FIVESIM_API_KEY=your_5sim_api_key_here
FIVESIM_BASE_URL=https://5sim.net/v1

# PVAPins - Mobile OTP (Secondary)
PVAPINS_API_KEY=your_pvapins_api_key_here
PVAPINS_BASE_URL=https://pvapins.com/api

# SMS-Activate - Mobile OTP (Backup)
SMSACTIVATE_API_KEY=your_smsactivate_api_key_here

# Application Settings
MAX_CONCURRENT_WORKERS=3
DEFAULT_DAILY_LIMIT=100
OTP_POLL_TIMEOUT_SECONDS=120
OTP_POLL_INTERVAL_SECONDS=5

# CAPTCHA Solving
# CapSolver (primary) — supports reCAPTCHA v2/v3, hCaptcha, Turnstile
CAPSOLVER_API_KEY=
# Anti-Captcha (fallback) — used when CapSolver fails
ANTICAPTCHA_API_KEY=

# Bright Data Scraping Browser (remote browser on residential IPs)
# Format: wss://brd-customer-XXXXX-zone-XXXXX:PASSWORD@brd.superproxy.io:9222
BRIGHT_DATA_BROWSER_WSS=

# Proxy (optional)
PROXY_URL=
PROXY_BAN_THRESHOLD=5
PROXY_COOLDOWN_SECONDS=60
PROXY_RATE_LIMIT_COOLDOWN=300
PROXY_MAX_FAIL_RATE_PCT=50

# Error Handling & Resilience
ERROR_SCREENSHOT_ON_FAILURE=true
ERROR_HTML_SNAPSHOT_ON_FAILURE=true
ERROR_BROWSER_LOG_ON_FAILURE=true
ERROR_NETWORK_LOG_ON_FAILURE=true
ERROR_MAX_CONSOLE_LOGS=50
ERROR_MAX_NETWORK_LOGS=200
ERROR_MAX_DEBUG_REPORTS_DAYS=7

# Secret key (used for JWT signing and credential encryption — generate a strong random value)
SECRET_KEY=change-me-to-a-random-secret

# Security
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX=60
RATE_LIMIT_DEFAULT_WINDOW=60
SECURITY_HEADERS_ENABLED=true
ENABLE_HSTS=true
ENABLE_CSP=true
AUDIT_LOG_ENABLED=true
CELERY_REDIS_SSL=false
CORS_ALLOWED_ORIGINS=*
